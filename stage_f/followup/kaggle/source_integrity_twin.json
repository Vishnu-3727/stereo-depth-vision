        "+    ref_state = ref_blob[\"model\"] if isinstance(ref_blob, dict) and \"model\" in ref_blob else ref_blob",
        "+    ref_keys = sorted(ref_state.keys())",
        "     keys = sorted(model.state_dict().keys())",
        "     params = sum(p.numel() for p in model.parameters())",
        "@@ -161,5 +163,5 @@",
