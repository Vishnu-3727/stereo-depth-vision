  "declared_deltas": {
    "scripts/finetune_pilot.py": {
      "scope": "M1 INTERVENTION ONLY - training loss gains the Laplacian CE term (lambda=1.0); optimizer, scheduler, data, aug, validation, checkpointing, init, seed, determinism unchanged",
      "edits": [
        {
          "why": "M1 needs torch.nn.functional (interpolate / log_softmax); nothing else uses it, so it is added on its own line.",
          "old": "import torch\nfrom torch.utils.data import DataLoader, Dataset",
          "new": "import torch\nimport torch.nn.functional as F\nfrom torch.utils.data import DataLoader, Dataset"
        },
        {
          "why": "M1 training term: forward with return_stages, upsample the aggregated cost, standardise exactly as soft_argmin(normalize=True), Laplacian (b=0.5) target over the config's candidates, lambda=0.1.",
          "old": "out = model(left, right)\n            loss, n = masked_smooth_l1(out, disparity, max_disparity=float(config.max_disparity",
          "new": "out, _st = model(left, right, return_stages=True)\n            loss, n = masked_smooth_l1(out, disparity, max_disparity=float(config.max_disparity_px))\n         "
        },
        {
          "why": "Accumulate the per-batch M1 CE so the epoch mean can be logged.",
          "old": "epoch_loss, epoch_pixels, batches = 0.0, 0, 0",
          "new": "epoch_loss, epoch_pixels, batches = 0.0, 0, 0\n        epoch_ce = 0.0"
        },
        {
          "why": "Add this batch's M1 CE to the epoch accumulator.",
          "old": "epoch_loss += float(loss)",
          "new": "epoch_loss += float(loss)\n            epoch_ce += float(_m1_ce.detach())"
        },
        {
          "why": "Log row carries m1_ce (epoch mean of the CE term).",
          "old": "row = {\"epoch\": epoch, \"mean_loss\": epoch_loss / max(batches, 1),\n               \"valid_pixels\": epoch_pixels, \"lr\": flo",
          "new": "row = {\"epoch\": epoch, \"mean_loss\": epoch_loss / max(batches, 1),\n               \"m1_ce\": epoch_ce / max(batches, 1),\n               \"valid_pixels\": epoch_pixel"
        },
        {
          "why": "Printed line shows the epoch-mean M1 CE next to the loss.",
          "old": "print(\"epoch {:>3} loss {:8.4f} lr {:.2e}{}\".format(\n            epoch, row[\"mean_loss\"], row[\"lr\"],",
          "new": "print(\"epoch {:>3} loss {:8.4f} ce {:8.4f} lr {:.2e}{}\".format(\n            epoch, row[\"mean_loss\"], row[\"m1_ce\"], row[\"lr\"],"
        }
      ],
      "m1_lambda": 1.0,
      "unified_diff": [
        "--- bundle/scripts/finetune_pilot.py",
        "+++ bundle_f1m10/scripts/finetune_pilot.py",
        "@@ -35,4 +35,5 @@",
        " import numpy as np",
        " import torch",
        "+import torch.nn.functional as F",
        " from torch.utils.data import DataLoader, Dataset",
        " ",
        "@@ -294,16 +295,32 @@",
        "     for epoch in range(EPOCHS):",
        "         epoch_loss, epoch_pixels, batches = 0.0, 0, 0",
        "+        epoch_ce = 0.0",
        "         for left, right, disparity in loader:",
        "             left, right, disparity = left.to(device), right.to(device), disparity.to(device)",
        "-            out = model(left, right)",
        "+            out, _st = model(left, right, return_stages=True)",
        "             loss, n = masked_smooth_l1(out, disparity, max_disparity=float(config.max_disparity_px))",
        "+            # M1 distribution supervision: CE between the full-res cost softmax",
        "+            # and a normalised Laplacian target, same valid mask as above.",
        "+            _m1_cost = _st[\"aggregated_cost\"]",
        "+            _m1_up = F.interpolate(_m1_cost, size=disparity.shape[-2:], mode=\"bilinear\", align_corners=True)",
        "+            _m1_norm = (_m1_up - _m1_up.mean(1, keepdim=True)) / (_m1_up.std(1, keepdim=True) + 1e-6)",
        "+            _m1_logp = F.log_softmax(-_m1_norm, dim=1)",
        "+            _m1_valid = (disparity > 0) & (disparity < float(config.max_disparity_px))",
        "+            _m1_t = disparity / float(config.feature_stride)",
        "+            _m1_k = torch.arange(config.num_disparities, dtype=_m1_up.dtype, device=_m1_up.device).view(1, -1, 1, 1)",
        "+            _m1_q = torch.softmax(-torch.abs(_m1_k - _m1_t) / 0.5, dim=1)",
        "+            _m1_ce_map = -(_m1_q * _m1_logp).sum(1, keepdim=True)",
        "+            _m1_ce = _m1_ce_map[_m1_valid].mean() if int(_m1_valid.sum()) > 0 else _m1_up.sum() * 0.0",
        "+            loss = loss + 1.0 * _m1_ce",
        "             optimizer.zero_grad(set_to_none=True)",
        "             loss.backward()",
        "             optimizer.step()",
        "             epoch_loss += float(loss)",
        "+            epoch_ce += float(_m1_ce.detach())",
        "             epoch_pixels += n",
        "             batches += 1",
        "         scheduler.step()",
        "         row = {\"epoch\": epoch, \"mean_loss\": epoch_loss / max(batches, 1),",
        "+               \"m1_ce\": epoch_ce / max(batches, 1),",
        "                \"valid_pixels\": epoch_pixels, \"lr\": float(scheduler.get_last_lr()[0])}",
        "         if epoch % 5 == 0 or epoch == EPOCHS - 1:",
        "@@ -319,6 +336,6 @@",
        "         fh.write(json.dumps(row) + \"\\n\")",
        "         fh.flush()",
        "-        print(\"epoch {:>3} loss {:8.4f} lr {:.2e}{}\".format(",
        "-            epoch, row[\"mean_loss\"], row[\"lr\"],",
        "+        print(\"epoch {:>3} loss {:8.4f} ce {:8.4f} lr {:.2e}{}\".format(",
        "+            epoch, row[\"mean_loss\"], row[\"m1_ce\"], row[\"lr\"],",
        "             \" val EPE {:.3f} D1 {:.2f}%\".format(row[\"val_epe\"], row[\"val_d1\"])",
