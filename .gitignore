experiments/**/*.pth
experiments/**/*.ckpt
experiments/**/*.onnx
experiments/**/events.out.tfevents.*
results/**/*.png
results/**/*.npy
results/**/*.npz
logs/
# python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ipynb_checkpoints/
